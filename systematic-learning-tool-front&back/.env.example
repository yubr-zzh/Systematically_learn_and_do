# =============================================================
# Systematically Learn and Do - Server Environment Template
# =============================================================
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored. NEVER commit real keys.
# =============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# SQLite file location (relative to project root). Leave default for local dev.
DB_PATH=./data/systematically.db

# --- AI Provider (DeepSeek-compatible OpenAI Chat Completions API) ---
# Required. Server will warn at startup and fall back to a static template
# if missing or still set to the placeholder below. Set a real key to
# enable live AI-generated reports.
DEEPSEEK_API_KEY=replace-me-with-your-real-key

# Override these if you want to point at a different OpenAI-compatible endpoint
# (e.g. a local proxy, Azure, OpenRouter, or a self-hosted model).
API_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- Fresh web research (optional but recommended for current facts) ---
# auto prefers Tavily, then Brave. Use none to disable network search explicitly.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=replace-me-with-your-tavily-key
BRAVE_SEARCH_API_KEY=replace-me-with-your-brave-key
WEB_SEARCH_TIMEOUT_MS=12000
WEB_SEARCH_MAX_RESULTS=8

# --- CORS & Rate Limiting ---
# Comma-separated list of allowed CORS origins (production). Empty = allow all (dev).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Max requests per IP per window. Set to 0 to disable.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
