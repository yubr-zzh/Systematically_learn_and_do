# =============================================================
# Systematically Learn and Do - Server Environment Template
# =============================================================
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored. NEVER commit real keys.
# =============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# SQLite file location (relative to project root). Leave default for local dev.
DB_PATH=./data/systematically.db

# --- AI Provider (DeepSeek-compatible OpenAI Chat Completions API) ---
# Required. Server will warn at startup and fall back to a static template
# if missing or still set to the placeholder below. Set a real key to
# enable live AI-generated reports.
DEEPSEEK_API_KEY=replace-me-with-your-real-key

# Override these if you want to point at a different OpenAI-compatible endpoint
# (e.g. a local proxy, Azure, OpenRouter, or a self-hosted model).
API_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
